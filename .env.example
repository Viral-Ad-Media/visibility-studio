# Copy to .env.local for `npm run dev`, or to .env for Docker / docker compose,
# and fill in. Never commit the filled-in copy — both names are gitignored.
#
# Docker note: the NEXT_PUBLIC_* block is inlined into the JS bundle at BUILD
# time (passed as --build-arg / compose build args), so changing any of them
# means rebuilding the image. Everything below it is read at RUNTIME only
# (docker run --env-file .env) and is never written into an image layer.

# --- Public (build-time) ---
# `next dev` listens on 3000; `npm start` and the Docker image listen on 3300.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative (set one public key, not a service_role or secret key):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# --- Secret (runtime) ---
DATABASE_URL=
# Verified TLS is the default. Supply your database provider's CA if needed.
DATABASE_CA_CERT=
# Only for a local, non-TLS database:
# DATABASE_SSL=disable
ANTHROPIC_API_KEY=
ENGINE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
# Required only for the operator CLI; selects the account it may inspect/mutate.
VIS_OPERATOR_ACCOUNT_ID=
