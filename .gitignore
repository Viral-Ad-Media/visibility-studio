# dependencies
/node_modules

# next.js build output
/.next/
tsconfig.tsbuildinfo

# local SQLite database — real audited business data, not source, stays local
/data/*.db
/data/*.db-shm
/data/*.db-wal

# env / secrets (this app doesn't use any today, but never commit them)
.env
.env.local
.env*.local

# OS cruft
.DS_Store

# Trigger.dev CLI runtime cache (Phase B used this, then got dropped for a
# pg_net/pg_cron-based engine instead — never track this if it reappears)
.trigger/
